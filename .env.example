# ── Anthropic Claude ──────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI Whisper (voice transcription) ──────────
OPENAI_API_KEY=

# ── Encryption (32 random bytes as hex, run: openssl rand -hex 32) ──
ENCRYPTION_KEY=

# ── Notion OAuth ──────────────────────────────────
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/auth/callback/notion

# ── Notion Internal Integration ───────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_REAL_DATA=

# ── Google OAuth (via NextAuth) ───────────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── NextAuth ──────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ── Access Control ────────────────────────────────
ALLOWED_EMAIL=

# ── Vercel KV (Upstash Redis) ─────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Vercel Blob ───────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Sentry ────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Cron Security ─────────────────────────────────
CRON_SECRET=

# ── App ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
